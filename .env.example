# ─── Discord ────────────────────────────────────────────────────────────────
# Developer Portal → Bot → Reset Token. Niemals committen.
DISCORD_TOKEN=dein_discord_bot_token

# Für Kanal-Modi (media/counting) und die Eingangsschleuse werden
# Message Content + Server Members Intent benötigt. Sind sie im Developer
# Portal noch nicht aktiv: auf false setzen, dann läuft der Bot ohne
# Kanal-Modi und Eingangsschleuse.
ENABLE_PRIVILEGED_INTENTS=true

# Wohin /template backup erstellen die JSON-Dateien schreibt.
# Auf Railway: auf ein Volume zeigen lassen, damit Backups Deploys überleben.
# BACKUP_DIR=data/backups

# Optional: sofortige Slash-Command-Synchronisierung beim Testen
# DISCORD_GUILD_ID=123456789012345678

# ─── Premium ────────────────────────────────────────────────────────────────
# Persönliche Premium-Keys kommen per DM: ein Klick auf „Jetzt mehr
# Templates mit Premium freischalten" schickt dem Nutzer einen eigenen,
# einmaligen Key. Dafür ist kein Master-Key nötig.
#
# Der Master-Key ist der zweite, klassische Weg. Ohne Wert bleibt er
# schlicht ausgeschaltet — der sichere Standard. Einen eigenen Key setzen,
# niemals einen aus einem Repository.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PREMIUM_KEY=

# Optional: weitere gültige Keys, per Komma getrennt
# PREMIUM_EXTRA_KEYS=Key Zwei,Key Drei

# true = ein Unlock gilt für den ganzen Server statt nur für den Einlöser
PREMIUM_UNLOCKS_GUILD=false

# Ablageort der Freischaltungen (auf Railway auf ein Volume legen!)
PREMIUM_STORE=data/premium.json

# ─── Lizenzen über den University Bot ───────────────────────────────────────
# Statt eines Master-Keys, den jeder weitergeben kann, kauft man dort einen
# persönlichen Key und löst ihn im Dashboard ein. Dieser Bot fragt dann nur
# noch nach, ob das Discord-Konto Premium hat.
#
# Bleiben beide Felder leer, ändert sich nichts: es gilt weiter der
# PREMIUM_KEY von oben.
#
# Beide Werte sind nötig — eine URL ohne Token liefert nur 401.
# MAIN_BOT_URL=https://universtiy-bot.up.railway.app

# Muss exakt dem Wert beim University Bot entsprechen.
# PREMIUM_PARTNER_TOKEN=

# ─── Emojis ─────────────────────────────────────────────────────────────────
# Übernimmt beim Start die Emojis des University Bots unter diese App.
# App-Emojis gehören genau einer Anwendung, deshalb Kopien statt geteilter
# Nutzung. Nach dem ersten Start ist nichts mehr zu tun.
# false = es bleibt bei Unicode-Zeichen.
EMOJI_SYNC=true

# ─── Partner-Handshake (automatische Einrichtung) ───────────────────────────
# Gemeinsames Secret mit dem Partner-Bot. Bei BEIDEN Bots derselbe Wert.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Ohne diesen Wert ist die Automatik komplett aus.
# PARTNER_HANDSHAKE_SECRET=

# Muss im Developer Portal unter OAuth2 → Redirects EXAKT so eingetragen sein.
# OAUTH_REDIRECT_URI=https://dein-bot.example/oauth/callback

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Welche Vorlage ein Partner-Server automatisch bekommt.
PARTNER_TEMPLATE=community

# Dauerhafter Vermerk, wo das Template schon lief (auf Railway ins Volume!).
SETUP_LEDGER=data/setup_ledger.json

# ─── Runtime ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
HEALTH_SERVER=true

# ─── Branding ───────────────────────────────────────────────────────────────
BRAND_NAME=Discord Architect
BRAND_TAGLINE=Server-Templates in Sekunden
BRAND_FOOTER=Discord Architect • Vexo × Fufi
