# ─── Discord ────────────────────────────────────────────────────────────────
# Developer Portal → Bot → Reset Token. Niemals committen.
DISCORD_TOKEN=dein_discord_bot_token

# Für !start werden Message Content + Server Members Intent benötigt.
# Sind sie im Developer Portal noch nicht aktiv: auf false setzen,
# dann läuft der Bot weiter und /start bleibt nutzbar.
ENABLE_PRIVILEGED_INTENTS=true

# Prefix für !start
COMMAND_PREFIX=!

# Optional: sofortige Slash-Command-Synchronisierung beim Testen
# DISCORD_GUILD_ID=123456789012345678

# ─── Premium ────────────────────────────────────────────────────────────────
# Ohne Wert lässt sich Premium gar nicht freischalten — das ist der sichere
# Standard. Einen eigenen Key setzen, niemals einen aus einem Repository.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
PREMIUM_KEY=

# Optional: weitere gültige Keys, per Komma getrennt
# PREMIUM_EXTRA_KEYS=Key Zwei,Key Drei

# true = ein Unlock gilt für den ganzen Server statt nur für den Einlöser
PREMIUM_UNLOCKS_GUILD=false

# Ablageort der Freischaltungen (auf Railway auf ein Volume legen!)
PREMIUM_STORE=data/premium.json

# ─── Partner-Handshake (automatische Einrichtung) ───────────────────────────
# Gemeinsames Secret mit dem Partner-Bot. Bei BEIDEN Bots derselbe Wert.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Ohne diesen Wert ist die Automatik komplett aus.
# PARTNER_HANDSHAKE_SECRET=

# Muss im Developer Portal unter OAuth2 → Redirects EXAKT so eingetragen sein.
# OAUTH_REDIRECT_URI=https://dein-bot.example/oauth/callback

# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Welche Vorlage ein Partner-Server automatisch bekommt.
PARTNER_TEMPLATE=community

# Dauerhafter Vermerk, wo das Template schon lief (auf Railway ins Volume!).
SETUP_LEDGER=data/setup_ledger.json

# ─── Runtime ────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=INFO
HEALTH_SERVER=true

# ─── Branding ───────────────────────────────────────────────────────────────
BRAND_NAME=Discord Architect
BRAND_TAGLINE=Server-Templates in Sekunden
BRAND_FOOTER=Discord Architect • Vexo × Fufi
